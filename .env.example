# Required Environment Variables

# MongoDB Connection
MONGODB_URI=your_mongodb_connection_string

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_bucket_name

# Address Autocomplete Provider
# ADDRESS_PROVIDER=aws    -> Amazon Location Service (default). Reuses the AWS
#                            credentials above; needs geo-places:Autocomplete,
#                            geo-places:GetPlace, geo-places:Geocode on the IAM user/role.
# ADDRESS_PROVIDER=google -> legacy Google Maps (requires MAPS_API_KEY below)
ADDRESS_PROVIDER=aws
# Optional: override region if AWS_REGION is not a GeoPlaces-supported region
# AWS_GEO_REGION=us-east-1
# Optional: restrict results to a country (default USA). Set empty for worldwide.
# ADDRESS_COUNTRY=USA

# Google Maps API (only needed when ADDRESS_PROVIDER=google)
# Get your key from: https://console.cloud.google.com/
# Enable: Places API and Geocoding API
MAPS_API_KEY=your_google_maps_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Email Service Configuration (Gmail)
# 
# OPTION 1: OAuth2 with Refresh Token (RECOMMENDED for Production)
# More secure and no daily limits
# Setup: https://developers.google.com/gmail/api/quickstart/nodejs
# 1. Go to Google Cloud Console: https://console.cloud.google.com/
# 2. Create a new project or select existing
# 3. Enable Gmail API
# 4. Create OAuth 2.0 credentials (Desktop app)
# 5. Download credentials and get Client ID & Client Secret
# 6. Generate refresh token using OAuth2 Playground: https://developers.google.com/oauthplayground/
#    - Select Gmail API v1 → https://mail.google.com/
#    - Authorize APIs
#    - Exchange authorization code for tokens
#    - Copy the refresh token
EMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token
EMAIL_FROM_NAME=Heroic Funding

# OPTION 2: App Password (Fallback for Development)
# If OAuth2 is not set up, system will use App Password
# Generate at: https://myaccount.google.com/apppasswords
# EMAIL_PASSWORD=your-16-char-app-password

# Application URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_DEPLOYED_URL=https://your-production-frontend.com
SUPPORT_EMAIL=support@logicspark.com

# SendGrid Email Configuration (Production)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=sender@yourdomain.com
# Comma-separated recipients notified on every application submission
ADMIN_EMAILS=camerongroom@gmail.com,josh@palisadesadvance.com,kapil@logicspark.io

FOLLOW_UP_EMAIL_DELAY_MINUTES=10

